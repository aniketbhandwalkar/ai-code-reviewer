# ========================================================
# AI Code Reviewer - Application Configuration
# ========================================================

# LLM Provider API Keys (Leave empty to use System Environment Variables)
# - Google Gemini: Used for RAG Text Embeddings (text-embedding-004)
# - Groq: Used for High-Speed Llama 3.3 70B Code Analysis Inference
google.api.key=
groq.api.key=

# Sliding Window Engine Settings
sliding.window.size=20
sliding.window.overlap=5

# Default Coding Standards & Rules File (ClassPath resource or absolute path)
default.rules.file=Standards.txt

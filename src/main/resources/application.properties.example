# Google Gemini API Key (For Vector Embeddings)
google.api.key=YOUR_GEMINI_API_KEY_HERE

# Groq API Key (For Llama 3.3 70B Fast Inference)
groq.api.key=YOUR_GROQ_API_KEY_HERE

# Model Configuration
google.embedding.model=gemini-embedding-001
groq.chat.model=llama-3.3-70b-versatile

# Sliding Window Engine Settings (Auto-adapts window size based on file scale)
sliding.window.adaptive=true
sliding.window.size=20
sliding.window.overlap=5

# Default Coding Standards & Rules File
default.rules.file=EnterpriseStandardsManual.txt
